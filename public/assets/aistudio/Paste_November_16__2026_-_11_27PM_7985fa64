                <div class="settings-group">
                    <div class="settings-item" @click="openPresetModal()">
                        <div class="click-row">
                            <span>预设配置</span>
                            <div style="display: flex; align-items: center; font-size: 14px; color: #888;">
                                <span style="color: #1a1a1a; font-weight: 500;" x-text="currentPreset"></span>
