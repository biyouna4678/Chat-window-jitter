<body 
    x-data="app()" 
    x-init="init()"
    :class="{ 'mode-chapter': currentMode === 'chapter', 'multi-select-mode': isMultiSelectMode }"
>
    <div class="bg-layer"></div>

    <div class="main-container">
        <header class="top-header">
            <div class="nav-bar">
                <div class="nav-btn icon-only" id="btn-header-close" x-show="!isMultiSelectMode">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </div>
                <div class="nav-btn" x-show="isMultiSelectMode" @click="cancelMultiSelect()" x-cloak>取消</div>

                <div class="nav-btn icon-only" id="open-settings" x-show="!isMultiSelectMode" @click="showSettingsPanel = true">
                    <svg viewBox="0 0 24 24" fill="#1a1a1a">
                        <circle cx="5" cy="12" r="2"></circle>
                        <circle cx="12" cy="12" r="2"></circle>
                        <circle cx="19" cy="12" r="2"></circle>
                    </svg>
                </div>
                <div class="nav-btn" x-show="isMultiSelectMode" @click="toggleSelectAll()" x-text="selectAllLabel" x-cloak>全选</div>
            </div>
            <div class="avatars-container">
                <div class="avatar-wrapper"><img src="https://i.ibb.co/27tgDqq0/IMG-6557.jpg"></div>
                <div class="avatar-wrapper"><img src="https://i.ibb.co/zvr3HYQ/IMG-6559.jpg"></div>
                <div class="center-heart"><svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></div>
            </div>
            <div class="header-divider"></div>
            <div class="status-text" x-text="statusText"></div>
        </header>

        <main class="chat-area" id="chat-area">
            <div class="chapter-container" id="messages-container">
                <!-- 对白模式 -->
                <template x-for="msg in dialogueMessages" :key="'d-' + msg.id">
                    <div class="message-row feedback-target"
                         x-show="currentMode === 'dialogue'"
                         :class="rowClasses(msg)"
                         :data-role="msg.role"
                         :data-id="msg.id"
                         @click="handleRowClick($event, msg)">
                        
                        <!-- AI 头像 -->
                        <div class="wet-glass msg-avatar-wrapper" x-show="msg.role === 'ai'"><img :src="msg.avatar"></div>
                        
                        <!-- 气泡内容（事件直接绑在这里，彻底杜绝找错元素） -->
                        <div class="wet-glass bubble" 
                             x-show="msg.role === 'ai' || msg.role === 'user'" 
                             :class="{ pressing: pressingMsgId === msg.id }" 
                             x-text="msg.content"
                             @touchstart="startPress($event, msg, $el)"
                             @touchend="endPress"
                             @touchmove="cancelPress"
                             @contextmenu.prevent="showMenuFromEvent($event, msg, $el)"></div>
                        
                        <!-- User 头像 -->
                        <div class="wet-glass msg-avatar-wrapper" x-show="msg.role === 'user'"><img :src="msg.avatar"></div>

                        <!-- 叙述文本 -->
                        <div class="narration-text" 
                             x-show="msg.role === 'narration'" 
                             :class="{ pressing: pressingMsgId === msg.id }" 
                             x-text="msg.content"
                             @touchstart="startPress($event, msg, $el)"
                             @touchend="endPress"
                             @touchmove="cancelPress"
                             @contextmenu.prevent="showMenuFromEvent($event, msg, $el)"></div>
                    </div>
                </template>

                <!-- 篇章模式 -->
                <template x-for="msg in chapterMessages" :key="'c-' + msg.id">
                    <div class="chapter-item feedback-target"
                         x-show="currentMode === 'chapter'"
                         :class="chapterClasses(msg)"
                         :data-role="msg.role"
                         :data-id="msg.id"
                         @click="handleRowClick($event, msg)">
                        
                        <!-- 叙述文本 -->
                        <div class="narration-text" 
                             x-show="msg.role === 'narration'" 
                             :class="{ pressing: pressingMsgId === msg.id }" 
                             x-text="msg.content"
                             @touchstart="startPress($event, msg, $el)"
                             @touchend="endPress"
                             @touchmove="cancelPress"
                             @contextmenu.prevent="showMenuFromEvent($event, msg, $el)"></div>

                        <div class="chapter-user-profile" :class="{ 'profile-right': msg.role === 'user' }" x-show="msg.role !== 'narration'">
                            <div class="chapter-avatar-glass"><img :src="msg.avatar" :alt="msg.name"></div>
                            <div class="profile-info-group">
                                <div class="profile-top-row"><span class="profile-name" x-text="msg.name"></span></div>
                                <div class="profile-signature" x-text="msg.signature"></div>
                            </div>
                        </div>
                        
                        <div class="wet-glass-light chapter-bubble" :class="{ 'right': msg.role === 'user' }" x-show="msg.role !== 'narration'">
                            <!-- 篇章段落（事件直接绑在这里） -->
                            <p class="chapter-paragraph" 
                               :class="{ pressing: pressingMsgId === msg.id }" 
                               x-html="msg.content"
                               @touchstart="startPress($event, msg, $el)"
                               @touchend="endPress"
                               @touchmove="cancelPress"
                               @contextmenu.prevent="showMenuFromEvent($event, msg, $el)"></p>
                        </div>
                    </div>
                </template>
            </div>
        </main>

        <div class="bottom-input-container">
            <div class="glass-input-wrapper" :class="{ active: chatInput.trim().length > 0 }">
                <div class="btn-ai">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
                        <path d="M20 3v4"></path>
                        <path d="M22 5h-4"></path>
                        <path d="M4 17v2"></path>
                        <path d="M5 18H3"></path>
                    </svg>
                </div>
                <input type="text" class="glass-input" id="chatInput" x-model="chatInput" placeholder="输入消息..." @keydown.enter.prevent="sendMessage()">
